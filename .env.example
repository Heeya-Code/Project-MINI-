# Copy to .env (git-ignored) or set these in your hosting dashboard. Nothing here is required for local development.

# --- Server -----------------------------------------------------------------
PORT=3001
# Folder for the SQLite database and the uploaded timetable PDFs. MUST be on a persistent disk in production.
DATA_DIR=./server/data
NODE_ENV=production
# Set to 1 when the app runs behind an HTTPS proxy (Render, Railway, Fly, nginx ...).
TRUST_PROXY=1
APP_TZ=Asia/Kolkata
SESSION_HOURS=12
MAX_UPLOAD_MB=10

# --- Accounts ---------------------------------------------------------------
# Demo accounts (passwords are published in the README): keep them for demonstrations only.
# In any real deployment set SEED_DEMO_USERS=0 and create your own administrator:
SEED_DEMO_USERS=0
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Never enable on a server with real data ----------------------------------
# ALLOW_DEMO_RESET=1
